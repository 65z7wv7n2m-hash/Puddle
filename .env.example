# Copy this file to .env and fill it in.

# Your Anthropic API key (console.anthropic.com). Leave empty to use the built-in rule brain.
ANTHROPIC_API_KEY=

# Which Claude model makes Puddle's decisions. Haiku is fast and cheap.
CLAUDE_MODEL=claude-haiku-5-5

# 1 = Puddle follows your real clock (sleeps at night your time). 0 = fast days (12 real minutes each).
REAL_CLOCK=0

PORT=3000
